# REG.RU WANB DDNS updater env (install as /etc/default/regru-wanb-ddns, mode 0600)
REGRU_USERNAME=you@example.com
REGRU_PASSWORD='secret'
REGRU_ZONE_DOMAIN=bezrabotnyi.com
REGRU_RECORD_NAMES=router-b,home-b,remote100-b,remote88-b,remote44-b,88-b,cockpit-b,44-b
PRIMARY_SOURCE_IP=192.168.2.100
SECONDARY_INTERFACE=enp28s0f2np2
SECONDARY_SOURCE_IP=192.168.1.100
SECONDARY_GATEWAY=192.168.1.1
SECONDARY_TABLE_ID=101
SECONDARY_RULE_PRIORITY=100
